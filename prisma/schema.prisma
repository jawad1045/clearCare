generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 4.1 DB1 — Companies Table (tbl_Companies)
model Company {
  id                    Int                    @id @default(autoincrement()) @map("Acct_ID")
  organization          String                 @db.VarChar(255)
  street                String?                @db.VarChar(255)
  city                  String                 @db.VarChar(100)
  state                 String                 @db.VarChar(50)
  zip                   String?                @db.VarChar(10)
  contactPhone          String                 @map("Contact_Phone") @db.VarChar(20)
  contactFirstName      String                 @map("Contact_FirstName") @db.VarChar(100)
  contactLastName       String                 @map("Contact_LastName") @db.VarChar(100)
  contactEmail          String                 @map("Contact_Email") @db.VarChar(255)
  contactTitle          String?                @map("Contact_Title") @db.VarChar(100)
  notes                 String?
  createdDate           DateTime               @default(now()) @map("Created_Date")
  isActive              Boolean                @default(true)
  mentalHealthReferrals MentalHealthReferral[]
  referrals             Referral[]
  users                 User[]

  @@map("tbl_Companies")
}

/// 4.2 DB2 — Users Table (tbl_Users)
model User {
  id                    Int                    @id @default(autoincrement()) @map("User_ID")
  acctId                Int?                   @map("Acct_ID")
  organization          String                 @db.VarChar(255)
  street                String?                @db.VarChar(255)
  city                  String?                @db.VarChar(100)
  state                 String?                @db.VarChar(50)
  zip                   String?                @db.VarChar(10)
  contactPhone          String                 @map("Contact_Phone") @db.VarChar(20)
  contactFirstName      String                 @map("Contact_FirstName") @db.VarChar(100)
  contactLastName       String                 @map("Contact_LastName") @db.VarChar(100)
  contactEmail          String                 @unique @map("Contact_Email") @db.VarChar(255)
  contactTitle          String?                @map("Contact_Title") @db.VarChar(100)
  password              String                 @db.VarChar(255)
  userRole              String                 @map("User_Role") @db.VarChar(50)
  notes                 String?
  isActive              Boolean                @default(true) @map("Is_Active")
  createdDate           DateTime               @default(now()) @map("Created_Date")
  mustChangePassword    Boolean                @default(false) @map("Must_Change_Password")
  mentalHealthReferrals MentalHealthReferral[]
  notifications         Notification[]
  referrals             Referral[]
  company               Company?               @relation(fields: [acctId], references: [id])
  referralNotes         ReferralNote[]
  bhReferralNotes       BHReferralNote[]

  @@map("tbl_Users")
}

/// 4.3 DB3 — Referrals Table (tbl_Referrals)
model Referral {
  id                 Int       @id @default(autoincrement()) @map("Referral_ID")
  userId             Int       @map("User_ID")
  companyAcctId      Int       @map("Company_Acct_ID")
  serviceType        String    @map("Service_Type") @db.VarChar(100)
  parentFirstName    String?   @map("Parent_FirstName") @db.VarChar(100)
  parentLastName     String?   @map("Parent_LastName") @db.VarChar(100)
  parentEmail        String?   @map("Parent_Email") @db.VarChar(255)
  parentPhone        String?   @map("Parent_Phone") @db.VarChar(20)
  patientFirstName   String    @map("Patient_FirstName") @db.VarChar(100)
  patientLastName    String    @map("Patient_LastName") @db.VarChar(100)
  dob                DateTime  @map("DOB") @db.Date
  grade              String?   @db.VarChar(100)
  race               String    @db.VarChar(100)
  gender             String    @db.VarChar(20)
  ssn                String    @default("") @map("SSN") @db.VarChar(255)
  patientId          String?   @map("Patient_ID") @db.VarChar(50)
  type               String?   @db.VarChar(100)
  priority           String?   @db.VarChar(50)
  status             String    @default("Pending") @db.VarChar(50)
  dateOfReferral     DateTime  @default(now()) @map("Date_of_Referral")
  referName          String    @map("Refer_Name") @db.VarChar(200)
  datePatientContact DateTime? @map("Date_Patient_Contact") @db.Date
  methodOfContact    String?   @map("Method_of_Contact") @db.VarChar(100)
  pdfResult          String?   @map("PDF_Result") @db.VarChar(512)
  clientAttachments  String[]  @map("Client_Attachments")
  notes              String?
  lastUpdated        DateTime  @updatedAt @map("Last_Updated")
  company            Company   @relation(fields: [companyAcctId], references: [id])
  user               User      @relation(fields: [userId], references: [id])
  statusHistory ReferralStatusHistory[]
  notesHistory  ReferralNote[]
  @@map("tbl_Referrals")
}

/// 4.4 DB4 — Mental Health Referrals Table (tbl_MentalHealthReferrals)
model MentalHealthReferral {
  id                Int       @id @default(autoincrement()) @map("MH_ID")
  userId            Int       @map("User_ID")
  companyAcctId     Int       @map("Company_Acct_ID")
  firstName         String    @map("First_Name") @db.VarChar(100)
  lastName          String    @map("Last_Name") @db.VarChar(100)
  phone             String    @db.VarChar(20)
  ssn               String    @default("") @map("SSN") @db.VarChar(255)
  patientId         String?   @map("Patient_ID") @db.VarChar(50)
  email             String?   @db.VarChar(255)
  gender            String    @db.VarChar(20)
  status            String    @default("Pending") @db.VarChar(50)
  appointmentDate   DateTime? @map("Appointment_Date") @db.Date
  pdfReport         String?   @map("PDF_Report") @db.VarChar(512)
  clientAttachments String[]  @map("Client_Attachments")
  referName         String    @map("Refer_Name") @db.VarChar(200)
  dateOfReferral    DateTime  @default(now()) @map("Date_of_Referral")
  notes             String?
  lastUpdated       DateTime  @updatedAt @map("Last_Updated")
  referralType      String[]  @map("Referral_Type")
  grade             String?   @db.VarChar(100)
  company           Company   @relation(fields: [companyAcctId], references: [id])
  user              User      @relation(fields: [userId], references: [id])
  statusHistory BHReferralStatusHistory[]
  notesHistory  BHReferralNote[]
  @@map("tbl_MentalHealthReferrals")
}

/// Singleton row (id always 1) holding global, admin-configurable app settings
model AppSetting {
  id                    Int      @id @default(1)
  sessionTimeoutMinutes Int      @default(1440) @map("Session_Timeout_Minutes")
  updatedAt             DateTime @updatedAt @map("Updated_At")

  @@map("tbl_AppSettings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("User_ID")
  title     String   @db.VarChar(255)
  message   String
  type      String   @db.VarChar(50)
  read      Boolean  @default(false)
  link      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("Created_At")
  user      User     @relation(fields: [userId], references: [id])

  @@map("tbl_Notifications")
}

model CompanyTitle {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model UserTitle {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model BHReferralStatusHistory {
  id         Int      @id @default(autoincrement()) @map("History_ID")
  referralId Int      @map("MH_ID")
  status     String   @db.VarChar(50)
  changedAt  DateTime @default(now()) @map("Changed_At")
  changedBy  Int?     @map("Changed_By_User_ID")

  referral MentalHealthReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  changes    String?  @db.Text

  @@map("tbl_BHReferralStatusHistory")
}

model ReferralStatusHistory {
  id         Int      @id @default(autoincrement()) @map("History_ID")
  referralId Int      @map("Referral_ID")
  status     String   @db.VarChar(50)
  changedAt  DateTime @default(now()) @map("Changed_At")
  changedBy  Int?     @map("Changed_By_User_ID")

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  changes    String?  @db.Text

  @@index([referralId])
  @@map("tbl_ReferralStatusHistory")
}

model ReferralNote {
  id         Int      @id @default(autoincrement()) @map("Note_ID")
  referralId Int      @map("Referral_ID")
  note       String   @db.Text
  status     String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("Created_At")
  updatedAt  DateTime @updatedAt @map("Updated_At")
  createdBy  Int      @map("Created_By_User_ID")

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [createdBy], references: [id])

  @@index([referralId])
  @@map("tbl_ReferralNotes")
}

model BHReferralNote {
  id         Int      @id @default(autoincrement()) @map("Note_ID")
  referralId Int      @map("MH_ID")
  note       String   @db.Text
  status     String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("Created_At")
  updatedAt  DateTime @updatedAt @map("Updated_At")
  createdBy  Int      @map("Created_By_User_ID")

  referral MentalHealthReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [createdBy], references: [id])

  @@index([referralId])
  @@map("tbl_BHReferralNotes")
}